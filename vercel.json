{
  "version": 2,
  "buildCommand": "echo 'No build needed'",
  "outputDirectory": ".",
  "cleanUrls": true,
  "routes": [
    { "src": "/international-payment.html", "dest": "/international-payment.html" },
    { "src": "/international-usd.html", "dest": "/international-usd.html" },
    { "src": "/callback.php", "dest": "/M-PESAstkpush/callback.php" },
    { "src": "/stkpush.php", "dest": "/M-PESAstkpush/stkpush.php" },
    { "src": "/stkpush2draws.php", "dest": "/M-PESAstkpush/stkpush2draws.php" },
    { "src": "/stkpush2odds.php", "dest": "/M-PESAstkpush/stkpush2odds.php" },
    { "src": "/2draws.html", "dest": "/Tips/2draws.html" },
    { "src": "/2odds.html", "dest": "/Tips/2odds.html" },
    { "src": "/goldentips.html", "dest": "/Tips/goldentips.html" },
    { "src": "/contact-us.html", "dest": "/support/contact-us.html" },
    { "src": "/faq.html", "dest": "/support/faq.html" },
    { "src": "/how-it-works.html", "dest": "/support/how-it-works.html" },
    { "src": "/testimonial", "dest": "/testimonial/index.html" },
    { "src": "/testimonial/", "dest": "/testimonial/index.html" },
    { "src": "/jackpot", "dest": "/Jptips/index.html" },
    { "src": "/jackpot/", "dest": "/Jptips/index.html" },
    { "src": "/Jptips", "dest": "/Jptips/index.html" },
    { "src": "/Jptips/", "dest": "/Jptips/index.html" },
    { "src": "/", "dest": "/index.html" },
    { "src": "/index.html", "dest": "/index.html" },
    { "src": "/images/(.*)", "dest": "/images/$1" },
    { "src": "/(.*)\\.(js|css|png|jpg|jpeg|svg|gif|webp|ico)", "dest": "/$1.$2" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
