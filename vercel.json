{
  "version": 2,
  "buildCommand": "echo 'PHP site - no build needed'",
  "devCommand": "php -S localhost:3000",
  "installCommand": "echo 'No dependencies'",
  "framework": "none",
  "functions": {
    "index.php": { "runtime": "vercel-php@0.9.0" },
    "international-payment.php": { "runtime": "vercel-php@0.9.0" },
    "international-usd.php": { "runtime": "vercel-php@0.9.0" }
  },
  "routes": [
    { "src": "/international-payment\\.php", "dest": "/international-payment.php" },
    { "src": "/international-usd\\.php", "dest": "/international-usd.php" },
    { "src": "/(.*)", "dest": "/index.php" }
  ]
}