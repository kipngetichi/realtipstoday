{
  "version": 2,
  "buildCommand": "echo 'PHP site - no build needed'",
  "outputDirectory": ".",
  "devCommand": "php -S localhost:3000",
  "installCommand": "echo 'No dependencies'",
  "functions": {
    "api/**/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    { "src": "/international-payment\\.php", "dest": "/api/international-payment.php" },
    { "src": "/international-usd\\.php", "dest": "/api/international-usd.php" },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ]
}